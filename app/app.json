{
  "expo": {
    "name": "Govt Jobs BD",
    "slug": "govt-jobs-bd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "govtjobsbd",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.govtjobsbd"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#008A60",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.example.govtjobsbd"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#008A60",
          "dark": {
            "backgroundColor": "#006F4E"
          }
        }
      ],
      "expo-secure-store"
    ],
    "notification": {
      "icon": "./assets/images/notification-icon.png",
      "color": "#008A60"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
